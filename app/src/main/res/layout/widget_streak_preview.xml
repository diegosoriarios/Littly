<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_streak_bg"
    android:orientation="vertical"
    android:padding="14dp">

    <TextView
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:background="@color/widget_success"
        android:gravity="center"
        android:text="L"
        android:textColor="@color/widget_on_success"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="47"
        android:textColor="@color/widget_on_navy"
        android:textSize="44sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="DAY STREAK"
        android:textColor="@color/widget_on_navy_muted"
        android:textSize="11sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Read 20 pages"
        android:textColor="@color/widget_on_navy"
        android:textSize="12sp" />
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_idea_bg"
    android:orientation="vertical"
    android:padding="14dp">

    <TextView
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:background="@color/widget_idea_accent"
        android:gravity="center"
        android:text="💡"
        android:textSize="15sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="SKETCH IDEA"
        android:textColor="@color/widget_idea_label"
        android:textSize="11sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Draw a teapot from memory"
        android:textColor="@color/widget_idea_text"
        android:textSize="17sp"
        android:textStyle="bold" />
</LinearLayout>
